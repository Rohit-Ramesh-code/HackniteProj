# Application Settings
APP_NAME=Spatial Security Backend
DEBUG=True
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Gemini AI Threat Detection Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# SMTP Security Alert Configurations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=security-alerts@example.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=alerts@spatial-security.local
SMTP_MOCK_MODE=True
